# --- Sofuu backend ------------------------------------------------------
VELIORA_PORT=8080
VELIORA_HOST=127.0.0.1
VELIORA_STORE=.sofuu/veliora-store
VELIORA_MODE=scripted
VELIORA_PROVIDER=
VELIORA_MODEL=
VELIORA_CONFIDENCE_THRESHOLD=0.72
VELIORA_MAX_CYCLES=3
VELIORA_STEP_DELAY_MS=25
VELIORA_FALLBACK_SCRIPTED=1
VELIORA_WEB_SEARCH=0

# --- Authentication (Clerk) --------------------------------------------
# The API is authenticated. The browser/Android client must send
# `Authorization: Bearer <Clerk session token>` on every /v1 request.
# VELIORA_AUTH_MODE=dev is for local tests only and accepts
# `Authorization: Bearer dev:<user_id>`.
VELIORA_AUTH_MODE=clerk
VELIORA_APP_ORIGINS=https://veliora-app.rikuhana.com,http://localhost:3000,http://127.0.0.1:3000
VELIORA_DEV_USER=user_dev_local

# Clerk Frontend API values. Issuer and authorized parties are the origins
# that are allowed to mint tokens for this application.
CLERK_ISSUER=https://veliora-app.rikuhana.com
CLERK_JWKS_URL=https://veliora-app.rikuhana.com/.well-known/jwks.json
CLERK_AUTHORIZED_PARTIES=https://veliora-app.rikuhana.com
# Optional: token audience, if your Clerk instance sets one.
CLERK_AUDIENCE=
CLERK_CLOCK_SKEW_SECONDS=5
CLERK_JWKS_CACHE_MS=3600000
CLERK_JWKS_TIMEOUT_MS=10000

# --- Optional cloud inference ------------------------------------------
# Set provider/model and the provider's API key, then switch VELIORA_MODE to
# "sofuu". The key name depends on the provider configured in Sofuu.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
