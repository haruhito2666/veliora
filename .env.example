# --- Core local services -------------------------------------------------
DATABASE_URL=postgres://veliora:veliora@localhost:5432/veliora?sslmode=disable
NATS_URL=nats://localhost:4222
REDIS_URL=redis://localhost:6379
PORT=8080
ENV=dev
TEMPLATES_DIR=templates/organizations

# --- Optional LLM worker runtime ----------------------------------------
OPENAI_API_KEY=
VELIORA_LLM_MODEL=gpt-4o
VELIORA_LLM_MODEL_CHEAP=gpt-4o-mini
VELIORA_SCRIPTED_LLM=0
TAVILY_API_KEY=

# --- Optional Caspian channels ------------------------------------------
CASPIAN_SMTP_HOST=
CASPIAN_SMTP_PORT=587
CASPIAN_SMTP_USER=
CASPIAN_SMTP_PASSWORD=
CASPIAN_SMTP_FROM=
CASPIAN_RESEND_KEY=
CASPIAN_TELEGRAM_TOKEN=
