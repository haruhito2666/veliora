# --- Sofuu backend ------------------------------------------------------
VELIORA_PORT=8080
VELIORA_HOST=127.0.0.1
VELIORA_STORE=.sofuu/veliora-store
VELIORA_MODE=scripted
VELIORA_PROVIDER=
VELIORA_MODEL=
VELIORA_CONFIDENCE_THRESHOLD=0.72
VELIORA_MAX_CYCLES=3
VELIORA_STEP_DELAY_MS=25
VELIORA_FALLBACK_SCRIPTED=1

# --- Authentication (reference adapter: Clerk) -------------------------
# The reference app uses Clerk, but this repository ships no Clerk instance
# and no maintainer domain. Every /v1 request except /v1/health requires
# `Authorization: Bearer <token>`; there is no anonymous mode in the reference
# app. VELIORA_AUTH_MODE=dev is for local tests only.
# To use another provider, replace backend/sofuu/auth/clerk.js and the Android
# auth adapter; see README "Auth provider".
VELIORA_AUTH_MODE=clerk
VELIORA_APP_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
VELIORA_DEV_USER=user_dev_local

# Your Clerk Frontend API values. Replace the placeholders with your own
# instance; for a production custom domain use the Clerk hostname
# (for example, clerk.<your-domain>), not the app website.
CLERK_ISSUER=https://clerk.your-domain.example
CLERK_JWKS_URL=https://clerk.your-domain.example/.well-known/jwks.json
CLERK_AUTHORIZED_PARTIES=https://your-app.example.com,http://localhost,http://localhost:3000,http://127.0.0.1:3000
# Optional: token audience, if your Clerk instance sets one.
CLERK_AUDIENCE=
CLERK_CLOCK_SKEW_SECONDS=5
CLERK_JWKS_CACHE_MS=3600000
CLERK_JWKS_TIMEOUT_MS=10000

# --- Optional cloud inference ------------------------------------------
# Set provider/model and the provider's API key, then switch VELIORA_MODE to
# "sofuu". The key name depends on the provider configured in Sofuu.
# On Android, provider keys are provisioned into app-private storage at
# files/sofuu/provider-keys.json ({"openai":"sk-..."}); they are never baked
# into the APK. VELIORA_BASE_URL optionally points at an OpenAI-compatible
# endpoint or a local model server.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# VELIORA_BASE_URL=

# --- Android build (the app embeds the gateway; no backend host) ------
# The publishable key is public. Pass it to Gradle with -P or export it.
# Clerk issuer/JWKS fall back to CLERK_ISSUER / CLERK_JWKS_URL above.
# VELIORA_CLERK_PUBLISHABLE_KEY=pk_test_...
# VELIORA_CLERK_ISSUER=https://clerk.example.com
# VELIORA_CLERK_JWKS_URL=https://clerk.example.com/.well-known/jwks.json
# VELIORA_CLERK_AUTHORIZED_PARTIES=https://app.example.com
# VELIORA_EMBEDDED_MODE=scripted
# VELIORA_STEP_DELAY_MS=25
# VELIORA_PROVIDER=
# VELIORA_MODEL=
# After changing backend/sofuu, rebuild the committed JS asset with:
#   make embedded-js

# Release signing. These are secrets: keep them out of git and CI logs.
# VELIORA_RELEASE_STORE_FILE=/absolute/path/to/veliora-release.jks
# VELIORA_RELEASE_STORE_PASSWORD=
# VELIORA_RELEASE_KEY_ALIAS=veliora
# VELIORA_RELEASE_KEY_PASSWORD=
